# Copie a apps/api/.env y complete los valores. NUNCA suba .env al repositorio.
NODE_ENV=development
PORT=4000

# Base de datos (local con docker compose; en producción use la URL de Supabase)
DATABASE_URL=postgresql://agenda:agenda@localhost:5433/agenda_dev
# Conexión directa (sin pooler) usada por las migraciones. En local es igual a DATABASE_URL.
DIRECT_URL=postgresql://agenda:agenda@localhost:5433/agenda_dev

# Origen permitido del frontend (CORS). Varios separados por coma.
CORS_ORIGINS=http://localhost:5173
# En producción con dominios distintos: none. Con subdominios del mismo sitio: lax
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
BCRYPT_COST=12

# Correo (Resend). Si EMAIL_PROVIDER=console, solo se imprime en el log (desarrollo).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Agenda <agenda@su-dominio.example>

# Recordatorios: expresión cron (por defecto cada minuto) y activación del worker interno
REMINDER_CRON=* * * * *
ENABLE_WORKER=true
# Si usa un cron externo (Render Cron Job), defina un secreto largo y aleatorio
WORKER_SECRET=

# Datos del seed (solo desarrollo). Cambie las contraseñas.
SEED_ADMIN_PASSWORD=
SEED_ASSISTANT_PASSWORD=
